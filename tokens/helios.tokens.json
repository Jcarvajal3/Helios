  "shell": {
    "comment": "Capa semántica del armazón: qué superficie, qué radio y qué medida le toca a cada tipo de pieza. `surface` y `radius` guardan NOMBRES de rol (de color.role y de shape) y el generador los resuelve a su valor en cada tema, para que un cambio de paleta se propague solo.",
    "surface": {
      "comment": "Claves de color.role. La escalera va de más profundo a más elevado.",
      "canvas": "surfaceContainerLowest",
      "card": "surfaceContainerLow",
      "control": "surfaceContainerHigh",
      "inset": "surfaceContainerHighest",
      "bar": "surface"
    },
    "radius": {
      "comment": "Claves de shape. Solo hay dos formas: tarjeta y píldora.",
      "card": "extraLarge",
      "control": "full",
      "pressedCard": "large"
    },
    "padding": {
      "comment": "Margen interior por tipo de pieza.",
      "card": 20,
      "control": 20,
      "row": 16
    },
    "size": {
      "comment": "Alturas y diámetros fijos del armazón.",
      "control": 56,
      "chip": 40,
      "avatar": 44,
      "meter": 10
    },
    "gap": {
      "comment": "El ritmo vertical, en cinco pasos y dos agrupaciones. Tener nombres y no números es lo que impide que aparezca un margen suelto: para añadir uno hay que justificar un peldaño nuevo.",
      "tight": 4,
      "inner": 12,
      "group": 20,
      "block": 32,
      "section": 48,
      "stack": 8,
      "list": 12
    }
  },
