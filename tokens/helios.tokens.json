  "motion": {
    "comment": "M3 Expressive reemplazó duration+easing por muelles. `damping` es el RATIO de amortiguación (zeta) de la spec; el generador también emite `dampingCoefficient` = 2*zeta*sqrt(k*m), que es lo que esperan Reanimated y framer-motion. Pasar el ratio crudo como `damping` da un rebote descontrolado.",
    "spring": {
      "spatial": {
        "comment": "Posición, tamaño, forma. Puede sobrepasar y rebotar.",
        "fast": {
          "damping": 0.6,
          "stiffness": 800,
          "mass": 1
        },
        "default": {
          "damping": 0.8,
          "stiffness": 380,
          "mass": 1
        },
        "slow": {
          "damping": 0.8,
          "stiffness": 200,
          "mass": 1
        }
      },
      "effects": {
        "comment": "Color, opacidad, elevación. Nunca sobrepasa (zeta = 1, críticamente amortiguado).",
        "fast": {
          "damping": 1,
          "stiffness": 3800,
          "mass": 1
        },
        "default": {
          "damping": 1,
          "stiffness": 1600,
          "mass": 1
        },
        "slow": {
          "damping": 1,
          "stiffness": 800,
          "mass": 1
        }
      }
    },
    "duration": {
      "comment": "Legado M3. Solo para lo que un muelle no cubre: delays, secuencias, autoplay.",
      "short1": 50,
      "short2": 100,
      "short3": 150,
      "short4": 200,
      "medium1": 250,
      "medium2": 300,
      "medium3": 350,
      "medium4": 400,
      "long1": 450,
      "long2": 500,
      "long3": 550,
      "long4": 600,
      "extraLong1": 700,
      "extraLong2": 800,
      "extraLong3": 900,
      "extraLong4": 1000
    },
    "easing": {
      "emphasized": [
        0.2,
        0,
        0,
        1
      ],
      "emphasizedDecelerate": [
        0.05,
        0.7,
        0.1,
        1
      ],
      "emphasizedAccelerate": [
        0.3,
