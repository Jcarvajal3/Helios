  "font": {
    "comment": "Outfit para display/headline/title: una geométrica redondeada, cercana a la palabra del logotipo. Source Sans 3 (la de Ronda) para body/label. Las dos salen de Google Fonts (el panel las importa en styles.css). Helios no tiene app, así que no hay nombres de familia de React Native.",
    "family": {
      "display": {
        "css": "'Outfit', system-ui, -apple-system, 'Segoe UI', sans-serif"
      },
      "body": {
        "css": "'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 900
    }
  },
