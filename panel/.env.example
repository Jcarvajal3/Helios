# URL y clave publicable del proyecto de Supabase de Helios.
# Producción: el proyecto `Helios` (ahyfbnfsbyzdoyjzjvfb). Para dev o local,
# la URL y la clave que imprime `npx supabase status` desde la raíz del repo.
VITE_SUPABASE_URL=https://ahyfbnfsbyzdoyjzjvfb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# A qué base apunta este panel: desarrollo | produccion | local.
# Con `desarrollo` el menú del super admin lleva la pastilla DEV, para no
# confundir el proyecto de dev con producción. Tiene que decir lo mismo que
# VITE_SUPABASE_URL. Sin la variable se da por producción y no se pinta nada.
VITE_ENTORNO=

# Sentry (opcional). Sin DSN el panel no manda nada.
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# Solo en Vercel, para subir los source maps al compilar:
# SENTRY_AUTH_TOKEN=  SENTRY_ORG=  SENTRY_PROJECT=

# El asistente de IA del super admin (Edge Function `admin-asistente`, con
# Claude). Apagado salvo con `1`; en Vercel (producción) está en `1`.
VITE_ASISTENTE=

# La dirección pública del sitio, sin barra final: canonical, og:url, la imagen
# para compartir y /sitemap.xml. Vacía es https://conhelios.com.
VITE_SITIO_URL=
